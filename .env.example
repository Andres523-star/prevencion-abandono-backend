# =====================================================================================
# Variables de entorno de ejemplo. Copia a .env (que está en .gitignore) y completa.
# NUNCA subas .env ni valores reales al repositorio.
#
# Generar claves de 256 bits en Base64:
#   openssl rand -base64 32
# Generar hash argon2id y secreto TOTP de la cuenta break-glass: ver docs/break-glass.md
# =====================================================================================

# ---------- Perfil
SPRING_PROFILES_ACTIVE=dev

# ---------- PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=retencion
DB_SSLMODE=prefer
# Dueño del esquema (lo usa Flyway para migrar)
DB_MIGRATION_USER=retencion_owner
DB_MIGRATION_PASSWORD=
# Rol de la aplicación (privilegios mínimos)
DB_APP_USER=retencion_app
DB_APP_PASSWORD=
DB_APP_ROLE=retencion_app
DB_POOL_MAX=20

# ---------- Redis (rate limit y estado de login compartido)
APP_STATE_BACKEND=redis
REDIS_PASSWORD=
# Usa la misma contraseña de REDIS_PASSWORD: redis://:<contraseña>@localhost:6379
REDIS_URL=

# ---------- RabbitMQ (opcional: publica los eventos de dominio en el exchange retencion.events)
APP_RABBIT_ENABLED=false
RABBITMQ_USER=retencion
RABBITMQ_PASSWORD=
# amqp://<usuario>:<contraseña>@localhost:5672
RABBITMQ_ADDRESSES=

# ---------- Almacenamiento de evidencias: local (dev) o s3 (MinIO, Supabase Storage, Cloudflare R2, AWS S3)
APP_STORAGE_TYPE=s3
APP_STORAGE_LOCAL_DIR=
APP_PUBLIC_BASE_URL=http://localhost:8080
MINIO_ROOT_USER=retencion
MINIO_ROOT_PASSWORD=
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=retencion
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_CREATE_BUCKET=true
APP_EVIDENCE_MAX_SIZE=5MB

# ---------- Antivirus: clamav (producción) o signature (solo detecta EICAR; dev sin ClamAV)
APP_ANTIVIRUS_MODE=clamav
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# ---------- Correo de avisos de faltas al estudiante (único uso de correo de la plataforma)
# logging = no envía (solo registra el asunto); graph = Microsoft Graph; resend = Resend
APP_MAIL_PROVIDER=logging
APP_MAIL_DISPATCH_ENABLED=true
APP_MAIL_FROM=
APP_PORTAL_URL=http://localhost:5173
# Secreto HMAC del webhook de rebotes (openssl rand -hex 32); vacío = webhook deshabilitado
APP_MAIL_WEBHOOK_SECRET=
APP_MAIL_RESEND_API_KEY=
APP_MAIL_GRAPH_TENANT_ID=
APP_MAIL_GRAPH_CLIENT_ID=
APP_MAIL_GRAPH_CLIENT_SECRET=
APP_MAIL_GRAPH_MAILBOX=

# ---------- JWT propio de la plataforma (openssl rand -base64 32)
APP_JWT_SECRET=
APP_JWT_ACCESS_TTL=15m
APP_REFRESH_TTL=8h
APP_SESSION_MAX_LIFETIME=24h

# ---------- Cifrado de datos personales (cada una: openssl rand -base64 32, distintas entre sí)
APP_KMS_TYPE=local
APP_CRYPTO_ACTIVE_KEY_ID=local-v1
APP_CRYPTO_MASTER_KEY=
APP_CRYPTO_BLIND_INDEX_KEY=
# Claves retiradas tras una rotación, formato id:base64 separadas por coma
APP_CRYPTO_PREVIOUS_KEYS=
# Si APP_KMS_TYPE=vault
VAULT_URI=
VAULT_TOKEN=
VAULT_TRANSIT_KEY=retencion-pii

# ---------- Supabase Auth (ver docs/supabase-auth.md)
# Project Settings → API: URL del proyecto y clave pública "anon"/"publishable" (no es secreta)
SUPABASE_URL=https://<tu-proyecto>.supabase.co
SUPABASE_ANON_KEY=
# Solo si el proyecto usa aún el secreto JWT heredado (HS256); vacío = se usa el JWKS público
SUPABASE_JWT_SECRET=
# Recomendado: true (solo entran correos confirmados)
APP_REQUIRE_VERIFIED_EMAIL=true
# Vacío = se acepta cualquier dominio de correo
APP_ALLOWED_EMAIL_DOMAINS=
# Correos que reciben ADMIN en su primer ingreso (puesta en marcha)
APP_BOOTSTRAP_ADMIN_EMAILS=
# Rol por dominio (nunca roles privilegiados), formato dominio=ROL
APP_DEFAULT_ROLES_BY_DOMAIN=estudiantes.universidad.edu.co=ESTUDIANTE

# ---------- Cuenta de emergencia (break-glass)
BREAK_GLASS_ENABLED=false
BREAK_GLASS_USERNAME=
BREAK_GLASS_PASSWORD_HASH=
BREAK_GLASS_TOTP_SECRET=

# ---------- HTTP / seguridad
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173
APP_TRUSTED_PROXY_HOPS=0
APP_CLIENT_IP_HEADER=
APP_RATE_LIMIT_IP_CAPACITY=300
APP_RATE_LIMIT_USER_CAPACITY=600
APP_RATE_LIMIT_AUTH_CAPACITY=20
OPENAPI_ENABLED=true

# ---------- Observabilidad
OTEL_TRACING_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SAMPLING_PROBABILITY=0.1

# ---------- Datos sintéticos (solo perfil dev; genera estudiantes ficticios si la BD está vacía)
APP_SYNTHETIC_ENABLED=false
APP_SYNTHETIC_STUDENTS=50000

# ---------- IA (Claude, Fase 4). Sin clave el motor de riesgo usa solo reglas.
# La IA solo recibe datos seudonimizados (anon_code, rangos y métricas).
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
# Modelo capaz (casos críticos/retención) y económico (análisis masivo)
AI_MODEL_DEFAULT=claude-opus-5-5
AI_MODEL_TRIAGE=claude-haiku-5-5
AI_EFFORT_DEFAULT=medium
AI_EFFORT_TRIAGE=low
AI_TIMEOUT=60s
AI_CALLS_PER_MINUTE=60
AI_MAX_CONCURRENT_CALLS=8

# ---------- Motor de riesgo
APP_RISK_WORKER_ENABLED=true
APP_RISK_BATCH_ENABLED=true
# Lote nocturno (hora de Bogotá)
APP_RISK_BATCH_CRON=0 30 1 * * *

# ---------- Tiempo real (Fase 5): WebSocket/STOMP
# simple = una sola instancia (Render). relay = RabbitMQ con plugin rabbitmq_stomp (varias instancias)
APP_REALTIME_BROKER=simple
APP_REALTIME_RELAY_HOST=localhost
APP_REALTIME_RELAY_PORT=61613
APP_REALTIME_RELAY_LOGIN=guest
APP_REALTIME_RELAY_PASSCODE=guest
APP_REALTIME_SEND_PER_MINUTE=60
